# ─── Application ───
APP_NAME=kfc-order
APP_VERSION=1.0.0
APP_ENV=development
# Business day boundary: order numbers restart at 1 at local midnight.
APP_TIMEZONE=Europe/Moscow

# ─── Transports ───
HTTP_PORT=8003            # /health only
GRPC_PORT=9103
GRPC_SHUTDOWN_TIMEOUT=10s

# ─── Logger ───
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_OUTPUT=stdout
LOG_SERVICE=kfc-order

# ─── Database ───
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kfc_orders
DB_SSL_MODE=disable
DB_AUTO_MIGRATE=true

# ─── Kafka ───
KAFKA_BROKERS=localhost:29092
KAFKA_ORDERS_TOPIC=orders.events
